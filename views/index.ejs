<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Aufgabenliste</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/skeleton/2.0.4/skeleton.min.css">
  <style>
    .done-task { text-decoration: line-through; color: #999; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Aufgabenliste v1</h1>

    <% if (tasks.length === 0) { %>
      <p>Keine Aufgaben vorhanden.</p>
    <% } else { %>
      <table class="u-full-width">
        <thead>
          <tr>
            <th>Titel</th>
            <th>Beschreibung</th>
            <th>Fälligkeitsdatum</th>
            <th>Status</th>
            <th>Aktionen</th>
          </tr>
        </thead>
        <tbody>
          <% tasks.forEach(task => { %>
            <tr class="<%= task.done ? 'done-task' : '' %>">
              <td><%= task.title %></td>
              <td><%= task.description %></td>
              <td><%= task.dueDate %></td>
              <td><%= task.done ? 'Erledigt' : 'Offen' %></td>
              <td>
                <% if (!task.done) { %>
                  <form action="/aufgaben/<%= task.id %>/erledigt" method="POST" style="display:inline">
                    <input type="submit" value="Erledigt">
                  </form>
                <% } %>
                <form action="/aufgaben/<%= task.id %>/loeschen" method="POST" style="display:inline">
                  <input type="submit" value="Löschen">
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <p><a href="/aufgaben/neu" class="button">Neue Aufgabe erfassen</a></p>
  </div>
</body>
</html>